<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0B17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ตั้งค่า AI &amp; เสียงพากย์"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDoneSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="เสร็จ"
                android:textColor="#D0BFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gemini API Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Gemini AI (ใช้คีย์เดียวได้ทั้งแปล + พากย์)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Gemini API Key"
                android:textColorHint="#A79CB8"
                app:boxStrokeColor="#C94B94"
                app:endIconMode="password_toggle"
                app:endIconTint="#A79CB8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeminiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Gemini Model แปลซับ (เช่น gemini-3.8-flash)"
                android:textColorHint="#A79CB8"
                app:boxStrokeColor="#C94B94">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeminiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Voice Engine Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 เอนจินเสียงพากย์ (Voice Engine)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgVoiceEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbVoiceGemini"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#F472B6"
                    android:text="Gemini TTS — แนะนำ (ใช้แค่ Gemini Key)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbVoiceElevenLabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#F472B6"
                    android:text="ElevenLabs TTS (eleven_flash_v2_5)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbVoiceAndroid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#F472B6"
                    android:text="เสียงไทยในเครื่อง (Android TTS ฟรี 100%)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Gemini Voice Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="เลือกโทนเสียง Gemini TTS:"
                android:textColor="#A79CB8"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerGeminiVoice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="12dp" />

            <!-- ElevenLabs Credentials -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="ElevenLabs API Key (ถ้าใช้ ElevenLabs)"
                android:textColorHint="#A79CB8"
                app:boxStrokeColor="#C94B94"
                app:endIconMode="password_toggle"
                app:endIconTint="#A79CB8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etElevenKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="ElevenLabs Voice ID"
                android:textColorHint="#A79CB8"
                app:boxStrokeColor="#C94B94">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVoiceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoDub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="เปิดพากย์เสียงภาษาไทยอัตโนมัติ"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnTestVoice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:text="🔊 ทดสอบเสียงพากย์ (ประโยค GTA 6)"
                android:textColor="#FFEB5A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_gradient_start_btn"
            android:gravity="center"
            android:text="บันทึกการตั้งค่า"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
