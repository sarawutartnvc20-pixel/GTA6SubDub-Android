<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0B17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCloseWizard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="เชื่อมต่อ PS5 ง่ายๆ (3 ขั้นตอน)"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STEP 1: 2nd PSN Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ขั้นที่ 1: บัญชี PSN ที่ 2 (ไม่แย่งจอยหลัก)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep1Check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#FACC15"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="แนะนำ: กดปุ่มด้านล่างพิมพ์แค่ชื่อ PSN Online ID บัญชีที่ 2 (ไม่ต้องกรอกรหัสผ่าน) แล้วก๊อป Encoded ID มาวาง"
                android:textColor="#A79CB8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnOpenIdFinder"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gradient_start_btn"
                android:gravity="center"
                android:text="🔎 หา Account ID จากชื่อ PSN (ไม่ต้องใส่รหัส)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOpenSonyFallback"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:text="🌐 หรือเปิดหน้าล็อกอิน Sony (Chrome)"
                android:textColor="#D0BFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etAccountIdInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_dark"
                    android:hint="วาง Encoded ID (Base64) ที่นี่"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7A708D"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSaveAccountId"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_pink"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="บันทึก"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 2: Auto Discover PS5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ขั้นที่ 2: ค้นหา PS5 ในวง Wi-Fi อัตโนมัติ"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWizardDiscovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="กำลังสแกนหา PS5..."
                android:textColor="#A79CB8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etWizardPs5Ip"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_dark"
                android:hint="IP ของ PS5 (เช่น 192.168.1.50)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A708D"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- STEP 3: 8-digit PIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ขั้นที่ 3: กรอก PIN 8 หลักจาก PS5"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep3Check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#FACC15"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="บน PS5 ไปที่: การตั้งค่า > ระบบ > Remote Play > เชื่อมต่ออุปกรณ์"
                android:textColor="#A79CB8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etWizardPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:hint="กรอก PIN 8 หลัก"
                android:inputType="number"
                android:maxLength="8"
                android:textColor="#FFEB5A"
                android:textColorHint="#7A708D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWizardPair"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_gradient_start_btn"
                android:gravity="center"
                android:text="จับคู่ PS5 ทันที"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
