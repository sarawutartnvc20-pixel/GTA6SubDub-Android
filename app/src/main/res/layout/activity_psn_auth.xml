<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0B17"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClosePsn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="บัญชี PSN ที่สอง (Sony Login)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPsnHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ล็อกอินด้วยบัญชี PSN ฟรีอีกบัญชี (ไม่ใช่บัญชีหลักที่เล่น) เพื่อไม่ให้แย่งคอนโทรลเลอร์บน PS5"
        android:textColor="#A79CB8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnOpenChromeTab"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_start_btn"
        android:gravity="center"
        android:text="🌐 เปิดหน้าล็อกอิน Sony (Chrome Custom Tab)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <WebView
        android:id="@+id/webViewPsn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/etManualAccountId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="วางลิงก์ ?code=... หรือ Account ID (Base64)"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#7A708D"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSaveManualAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_pink"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="บันทึก"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
